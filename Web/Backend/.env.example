# Salin file ini menjadi `.env` lalu isi nilainya. File `.env` TIDAK ikut di-commit
# (sudah masuk .gitignore) — jangan pernah menaruh token asli di file lain.
#
# Dibaca otomatis oleh server.js lewat process.loadEnvFile() bawaan Node, jadi tidak
# perlu dependensi tambahan. Cukup `npm start` — tidak perlu set env di PowerShell.
# Nilai dari environment/shell tetap menang atas isi file ini.

# ── RAHASIA — ganti sebelum dipakai sungguhan ─────────────────────────────
# Daftar device=token dipisah koma. ESP32 mengirim header: Authorization: Bearer <token>
SMARTGUARD_DEVICE_TOKENS=sg-device-001=ganti-token-acak-panjang

# Bila diisi, firmware main_1.cpp wajib mengirim header X-Api-Key saat POST /api/telemetry.
# Kosongkan bila tidak dipakai.
SMARTGUARD_LEGACY_KEY=

# ── PORT & HOST ───────────────────────────────────────────────────────────
PORT=8000

# 0.0.0.0 = bisa diakses ESP32 di WiFi yang sama. Pakai 127.0.0.1 bila hanya
# ingin bisa diakses dari komputer ini saja.
HOST=0.0.0.0

# ── OPSIONAL ──────────────────────────────────────────────────────────────
# Dipakai hanya bila frontend di-host di origin berbeda. Pisahkan dengan koma.
SMARTGUARD_CORS_ORIGINS=
