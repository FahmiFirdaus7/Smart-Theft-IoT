#ifndef CONFIG_H
#define CONFIG_H

// ============================================================================
// SMARTGUARD — Template konfigurasi kredensial
// Salin file ini menjadi config.h lalu isi nilai aslinya.
// File config.h TIDAK di-commit ke git (lihat .gitignore root repo).
// ============================================================================

// WiFi
#define WIFI_SSID "<ssid-wifi>"
#define WIFI_PASSWORD "<password-wifi>"

// Web API (dashboard web-testing, server.js)
// Tanpa "/" di akhir dan tanpa "/api" — path /api/telemetry & /api/command
// ditambahkan otomatis oleh firmware.
#define WEB_API_URL "http://IP-LAPTOP:3001"

// API key opsional — aktifkan bila server memerlukan header X-Api-Key
// #define WEB_API_KEY "<api-key>"

// Device ID opsional — dikirim sebagai header X-Device-Id.
// Bila tidak didefinisikan, server memakai device "default" (cocok untuk
// satu perangkat + dashboard yang sudah ada).
// #define DEVICE_ID "sg-device-001"

// Kalibrasi baterai opsional (pembagi tegangan bawaan 2:1).
// Ukur tegangan baterai dengan multimeter, lalu sesuaikan calibration
// sampai nilai Serial Monitor sama.
// #define BATTERY_DIVIDER_RATIO 2.0f
// #define BATTERY_CALIBRATION 1.0f

// Interval opsional (milidetik)
// #define TELEMETRY_INTERVAL_MS 3000
// #define COMMAND_POLL_INTERVAL_MS 3000

#endif // CONFIG_H
